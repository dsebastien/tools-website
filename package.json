{
    "name": "tools-website",
    "private": true,
    "version": "3.8.0",
    "description": "Tools showcase website for dSebastien",
    "author": "Sébastien Dubois",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/tools-website.git"
    },
    "bugs": {
        "url": "https://github.com/dsebastien/tools-website/issues"
    },
    "homepage": "https://tools.dsebastien.net",
    "scripts": {
        "dev": "bun scripts/utils/dev.ts",
        "build": "bun run tsc && bun scripts/utils/build.ts && bun run --parallel generate:static-pages generate:sitemap generate:llms-txt generate:rss-feed",
        "build:ci": "bun run tsc && bun scripts/utils/build.ts && bun run --parallel generate:static-pages generate:sitemap generate:llms-txt generate:rss-feed",
        "generate:static-pages": "bun scripts/generate-static-pages.ts",
        "generate:sitemap": "bun scripts/generate-sitemap.ts",
        "generate:llms-txt": "bun scripts/generate-llms-txt.ts",
        "generate:rss-feed": "bun scripts/generate-rss-feed.ts",
        "preview": "bunx serve dist",
        "prepare": "husky",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write .",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "validate": "bun run --parallel tsc test lint",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "commit": "cz",
        "cm": "bun run commit",
        "commit:lint": "commitlint --from HEAD~1 --to HEAD --verbose",
        "release": "bash scripts/release.sh",
        "release:update-version": "bun scripts/update-version.ts",
        "release:changelog": "bun scripts/generate-changelog.ts",
        "push": "git push && git push --tags"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "engines": {
        "node": ">=20.0"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "^1.0.19",
        "clsx": "^2.1.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-icons": "5.5.0",
        "react-markdown": "^10.1.0",
        "react-router": "7.9.6",
        "tailwind-merge": "3.4.0"
    },
    "devDependencies": {
        "@commitlint/cli": "20.1.0",
        "@commitlint/config-conventional": "20.0.0",
        "@eslint/js": "^9.36.0",
        "@types/bun": "^1.2.10",
        "@types/node": "24.10.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "commitizen": "4.3.1",
        "conventional-changelog-cli": "5.0.0",
        "conventional-changelog-conventionalcommits": "9.1.0",
        "cz-customizable": "7.5.1",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "16.2.7",
        "prettier": "3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "serve": "^14.2.4",
        "tailwindcss": "4.1.17",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.48.0"
    }
}
